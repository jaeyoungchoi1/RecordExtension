{
  "manifest_version": 3,
  "name": "GazeAware Record Extension",
  "description": "Experimental web-browsing viewport and task setup recorder.",
  "version": "0.1.0",
  "action": {
    "default_title": "GazeAware Recorder",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "permissions": [
    "debugger",
    "downloads",
    "scripting",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
